---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  socialImage?: string | null;
  type?: "website" | "article";
}

const {
  title = "David Ballowe — Backend Engineer",
  description = "David Ballowe is a backend engineer with cloud experience, a love of the terminal, and an interest in dependable systems.",
  socialImage = "/og-monochrome.png",
  type = "website",
} = Astro.props;

const socialImageUrl = socialImage
  ? new URL(socialImage, Astro.site ?? Astro.url.origin)
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060907" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={Astro.url} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="David Ballowe, home"
          ><span>david_ballowe</span></a
        >
        <nav aria-label="Primary navigation">
          <a href="/#writing">/about</a>
          <a href="mailto:db@davidballowe.com">/email</a>
        </nav>
      </header>
      <slot />
      <footer class="site-footer">
        <p><span>david_ballowe</span></p>
        <p>© {new Date().getFullYear()} David Ballowe</p>
      </footer>
    </div>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    padding: 0.35rem 0.65rem;
    background: var(--accent);
    color: var(--background);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-shell {
    width: min(calc(100% - 2.5rem), var(--page-width));
    margin-inline: auto;
  }

  .site-header,
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-header {
    min-height: 5rem;
    border-bottom: 1px dashed var(--line);
  }

  .wordmark {
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark span,
  .site-footer span {
    color: var(--accent);
  }

  .site-header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
  }

  .site-header nav a {
    color: var(--muted);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .site-header nav a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .site-footer {
    padding-block: 1.5rem 2rem;
    border-top: 1px dashed var(--line);
    color: var(--muted);
  }

  .site-footer p {
    margin: 0;
    font-size: 0.75rem;
  }

  @media (max-width: 40rem) {
    .site-shell {
      width: min(calc(100% - 2rem), var(--page-width));
    }

    .site-header {
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
      gap: 0.35rem;
      min-height: 5.75rem;
    }

    .site-header nav {
      gap: 0.3rem 1rem;
    }

    .site-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
