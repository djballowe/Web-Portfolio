---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const formatDate = (date: Date) => date.toISOString().slice(0, 10).replaceAll("-", ".");
---

<BaseLayout
  title="Writing — David Ballowe"
  description="Notes from David Ballowe about engineering, products, and whatever he is curious about."
>
  <main id="main-content" class="blog-index">
    <header class="page-header">
      <p class="command"><span aria-hidden="true">$</span> cat ./writing/README.txt</p>
      <div class="command-output">
        <h1>Writing</h1>
        <p>Notes on engineering, products, and whatever I’m curious about.</p>
      </div>
      <p class="command"><span aria-hidden="true">$</span> ls -lt ./writing</p>
    </header>
    <ol class="post-list">
      {posts.map((post) => (
        <li>
          <a class="post-link" href={`/blog/${post.id}/`}>
            <time datetime={post.data.publishedAt.toISOString()}>
              {formatDate(post.data.publishedAt)}
            </time>
            <span>
              <strong>{post.data.title}</strong>
              <small>{post.data.description}</small>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </main>
</BaseLayout>
